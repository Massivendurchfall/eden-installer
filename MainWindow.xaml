<Window x:Class="EdenInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdenInstaller"
        Title="Eden Installer" Width="560" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!-- On very small screens it scrolls instead of cutting off -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border x:Name="Root" Background="{StaticResource BgBrush}" Padding="24,18,24,18">
      <StackPanel>

        <!-- Header -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Image Source="pack://application:,,,/eden-logo.png" Width="58" Height="58"
                 RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect Color="#EC4899" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
            </Image.Effect>
          </Image>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Eden Installer" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Border Style="{StaticResource Chip}">
                <TextBlock x:Name="ChipEden" Style="{StaticResource ChipText}"/>
              </Border>
              <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                <TextBlock x:Name="ChipFirmware" Style="{StaticResource ChipText}"/>
              </Border>
              <Border Style="{StaticResource Chip}" Margin="6,0,0,0">
                <TextBlock x:Name="ChipKeys" Style="{StaticResource ChipText}"/>
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Newer installer version on GitHub, or the note right after updating -->
        <Border x:Name="SelfUpdateCard" Style="{StaticResource Card}" BorderBrush="#4C3A7A" Margin="0,16,0,0"
                Padding="14,10,10,10" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SelfUpdateTitle" FontSize="13.5" Foreground="#C4B5FD" TextWrapping="Wrap"/>
              <TextBlock x:Name="SelfUpdateDetail" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Margin="0,2,0,0"/>
            </StackPanel>
            <Button x:Name="SelfUpdateButton" Grid.Column="1" Style="{StaticResource SmallButton}" VerticalAlignment="Center"
                    Margin="12,0,0,0" Click="OnSelfUpdate"/>
          </Grid>
        </Border>

        <!-- Installation -->
        <StackPanel x:Name="InstallPanel">

        <!-- Folder -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10,10,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{local:T De='Installationsordner', En='Install folder'}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="FolderText" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              <TextBlock x:Name="DataText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="ChangeFolderButton" Grid.Column="1" Style="{StaticResource SmallButton}"
                    Content="{local:T De='Ändern', En='Change'}" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnChangeFolder"/>
          </Grid>
        </Border>

        <!-- Steps -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8,5">
          <ItemsControl x:Name="StepsList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="6,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Grid Width="26" Height="26" VerticalAlignment="Top">
                    <Ellipse x:Name="Ring" Margin="1" Stroke="#3A3546" StrokeThickness="1.5"/>
                    <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#8C8698" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid x:Name="Spinner" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                      <Grid.RenderTransform>
                        <RotateTransform/>
                      </Grid.RenderTransform>
                      <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                               From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Grid.Triggers>
                      <Path Data="M 13,1.75 A 11.25,11.25 0 0 1 24.25,13" Stroke="{StaticResource AccentBrush}"
                            StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>

                    <Ellipse x:Name="DoneDot" Fill="{StaticResource SuccessBrush}" Visibility="Collapsed"/>
                    <Path x:Name="Check" Data="M 8,13.5 L 11.5,17 L 18.5,9.5" Stroke="#0E2219" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>

                    <Ellipse x:Name="FailDot" Fill="{StaticResource ErrorBrush}" Visibility="Collapsed"/>
                    <Path x:Name="Cross" Data="M 9.5,9.5 L 16.5,16.5 M 16.5,9.5 L 9.5,16.5" Stroke="White" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                  </Grid>

                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinHeight="26">
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13.5" Foreground="#9C96AA" Margin="0,4,0,0"/>
                    <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>

                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasDetail}" Value="False">
                    <Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Ring" Property="Stroke" Value="#2E2A37"/>
                    <Setter TargetName="Ring" Property="StrokeThickness" Value="2.6"/>
                    <Setter TargetName="Ring" Property="Margin" Value="1.3"/>
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DoneDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Title" Property="Foreground" Value="#DCD7E5"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FailDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="#E8A3AC"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- Progress -->
        <Grid Margin="0,14,0,0">
          <TextBlock x:Name="ProgressLabel" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"/>
          <TextBlock x:Name="ProgressValue" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"/>
        </Grid>
        <ProgressBar x:Name="Bar" Style="{StaticResource SlimProgress}" Margin="0,7,0,0"/>

        <!-- Buttons -->
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}" Click="OnSecondaryClick"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnPrimaryClick"/>
          </StackPanel>
        </Grid>

        </StackPanel>

        <!-- Home screen once Eden is installed -->
        <StackPanel x:Name="HomePanel" Visibility="Collapsed">

          <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10,10,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{local:T De='Eden ist installiert', En='Eden is installed'}" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="7,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="HomeFolderText" FontSize="13.5" Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                <TextBlock x:Name="NewsText" FontSize="12" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,5,0,0"
                           Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="ReinstallButton" Style="{StaticResource SmallButton}"
                        Content="{local:T De='Neu installieren', En='Reinstall'}" Click="OnReinstall"/>
                <Button x:Name="UninstallButton" Style="{StaticResource SmallButton}" Margin="0,6,0,0"
                        Content="{local:T De='Deinstallieren', En='Uninstall'}" Click="OnUninstall"/>
              </StackPanel>
            </Grid>
          </Border>

          <Button x:Name="AddGameButton" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Padding="18,13" Click="OnAddGame">
            <StackPanel>
              <TextBlock x:Name="AddGameTitle" Text="{local:T De='Spiel hinzufügen', En='Add game'}" FontSize="16" HorizontalAlignment="Center"/>
              <TextBlock x:Name="AddGameHint" FontSize="12" FontWeight="Normal" Opacity="0.85" Margin="0,3,0,0"
                         TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Button>

          <UniformGrid Columns="3" Margin="0,10,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{local:T De='Eden starten', En='Start Eden'}" Margin="0,0,5,0" Click="OnLaunchEden"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{local:T De='Games öffnen', En='Open Games'}" Margin="5,0,5,0" Click="OnOpenGames"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{local:T De='Updates öffnen', En='Open Updates'}" Margin="5,0,0,0" Click="OnOpenUpdates"/>
          </UniformGrid>

          <!-- Progress and result of "Add game" -->
          <StackPanel x:Name="ImportPanel" Visibility="Collapsed" Margin="0,16,0,0">
            <Grid>
              <TextBlock x:Name="ImportLabel" FontSize="12.5" Foreground="{StaticResource SubTextBrush}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,170,0"/>
              <TextBlock x:Name="ImportValue" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="ImportBar" Style="{StaticResource SlimProgress}" Margin="0,7,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8,4">
              <ScrollViewer x:Name="ResultsScroll" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ScrollViewer.Resources>
                  <!-- Slim dark bar instead of the light one from Windows -->
                  <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="MinWidth" Value="8"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                            <Track.Thumb>
                              <Thumb>
                                <Thumb.Template>
                                  <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Grip" CornerRadius="3" Background="#3A3546" Margin="1,0"/>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="#4A4458"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Thumb.Template>
                              </Thumb>
                            </Track.Thumb>
                          </Track>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="ResultsList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="6,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Badge" Width="84" CornerRadius="9" Padding="0,2,0,3" Margin="0,1,0,0"
                                VerticalAlignment="Top" Background="#2A2633">
                          <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="#CFC9DB" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                          <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="13"
                                     Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                     TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </StackPanel>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="Game">
                          <Setter TargetName="Badge" Property="Background" Value="#2D2452"/>
                          <Setter TargetName="BadgeText" Property="Foreground" Value="#C4B5FD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Mixed">
                          <Setter TargetName="Badge" Property="Background" Value="#2D2452"/>
                          <Setter TargetName="BadgeText" Property="Foreground" Value="#C4B5FD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Update">
                          <Setter TargetName="Badge" Property="Background" Value="#14304A"/>
                          <Setter TargetName="BadgeText" Property="Foreground" Value="#7DD3FC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Dlc">
                          <Setter TargetName="Badge" Property="Background" Value="#41193A"/>
                          <Setter TargetName="BadgeText" Property="Foreground" Value="#F9A8D4"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="Error">
                          <Setter TargetName="Badge" Property="Background" Value="#3D1A22"/>
                          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                          <Setter TargetName="Detail" Property="Foreground" Value="#E8A3AC"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>

          <TextBlock x:Name="HomeStatus" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>

      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>
